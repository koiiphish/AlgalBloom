# Copy this file to `.env` (which is git-ignored) and fill in the values.
# Never commit `.env`. In GitHub Actions, the same names are set as repository secrets.

# Copernicus Marine Service login (https://data.marine.copernicus.eu/register).
# Names verified against copernicusmarine 2.5.1 (`copernicusmarine login --help`).
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
